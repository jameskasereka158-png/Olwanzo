<!DOCTYPE html>
<html lang="fr" data-theme="sombre">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>OLWANZO — L'endroit où les Congolais se rencontrent</title>
    <!-- Fonts & Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --bg-dark: #0d0614;
            --purple-main: #9b51e0;
            --purple-gradient: linear-gradient(135deg, #a832e9, #6c11c9);
            --pink-accent: #e91e63;
            --card-bg: rgba(24, 12, 40, 0.96);
            --option-bg: rgba(255, 255, 255, 0.08);
            --option-border: rgba(255, 255, 255, 0.18);
            --text-main: #ffffff;
            --text-muted: #c3b1d9;
            --radius-lg: 28px;
            --radius-md: 16px;
            --transition: all 0.35s cubic-bezier(0.25, 1, 0.5, 1);
            
            /* Dynamic Theme Variables for Profile */
            --profile-bg: #0d0614;
            --profile-card-bg: rgba(255, 255, 255, 0.06);
            --profile-text: #ffffff;
            --profile-subtext: #c3b1d9;
            --profile-border: rgba(255, 255, 255, 0.12);
            --danger-color: #ff4d4d;
        }

        /* Thèmes de couleur adaptatifs pour le Profil */
        :root[data-theme="claire"] {
            --profile-bg: #f5edfc;
            --profile-card-bg: #ffffff;
            --profile-text: #1a0b2e;
            --profile-subtext: #6b5286;
            --profile-border: #e2d2f7;
        }

        :root[data-theme="moyen"] {
            --profile-bg: #1b0e2b;
            --profile-card-bg: rgba(255, 255, 255, 0.1);
            --profile-text: #ffffff;
            --profile-subtext: #d4c5e8;
            --profile-border: rgba(255, 255, 255, 0.2);
        }

        :root[data-theme="sombre"] {
            --profile-bg: #0d0614;
            --profile-card-bg: rgba(255, 255, 255, 0.06);
            --profile-text: #ffffff;
            --profile-subtext: #c3b1d9;
            --profile-border: rgba(255, 255, 255, 0.12);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Plus Jakarta Sans', sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        html, body {
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: var(--bg-dark);
            color: var(--text-main);
        }

        body {
            display: flex;
            justify-content: center;
            align-items: center;
            background-image: 
                radial-gradient(circle at 50% 10%, rgba(155, 81, 224, 0.25) 0%, transparent 50%),
                radial-gradient(circle at 80% 90%, rgba(233, 30, 99, 0.2) 0%, transparent 50%);
            background-attachment: fixed;
            padding: env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left);
        }

        .app-container {
            width: 100%;
            max-width: 480px;
            height: 100dvh;
            max-height: 920px;
            background: var(--card-bg);
            backdrop-filter: blur(30px);
            -webkit-backdrop-filter: blur(30px);
            border: 1px solid rgba(255, 255, 255, 0.12);
            display: flex;
            flex-direction: column;
            position: relative;
            overflow: hidden;
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.85);
            transition: var(--transition);
        }

        @media (min-width: 480px) and (min-height: 600px) {
            .app-container {
                height: 94dvh;
                border-radius: 36px;
            }
        }

        @media (max-width: 360px) {
            :root {
                --radius-lg: 20px;
                --radius-md: 12px;
            }
        }

        /* ==================== 1. SPLASH SCREEN ==================== */
        .splash-screen {
            position: absolute;
            inset: 0;
            background: #08030c;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            z-index: 100;
            transition: opacity 0.6s ease, visibility 0.6s ease;
        }

        .splash-logo {
            width: clamp(80px, 20vw, 110px);
            height: clamp(80px, 20vw, 110px);
            background: var(--purple-gradient);
            border-radius: 28px;
            display: flex;
            justify-content: center;
            align-items: center;
            box-shadow: 0 0 35px rgba(155, 81, 224, 0.7);
            animation: bounceLogo 1.2s infinite ease-in-out alternate;
        }

        .splash-logo i {
            font-size: clamp(2.2rem, 6vw, 3.2rem);
            color: #fff;
        }

        .splash-title {
            margin-top: 20px;
            font-size: clamp(1.4rem, 4vw, 1.8rem);
            font-weight: 800;
            letter-spacing: 1px;
            background: linear-gradient(to right, #ffffff, var(--purple-main));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        @keyframes bounceLogo {
            0% { transform: translateY(0) scale(1); }
            100% { transform: translateY(-16px) scale(1.05); box-shadow: 0 15px 45px rgba(233, 30, 99, 0.8); }
        }

        /* ==================== 2. LANDING SCREEN ==================== */
        .landing-screen {
            position: absolute;
            inset: 0;
            background: linear-gradient(to bottom, rgba(13, 6, 20, 0.45), rgba(13, 6, 20, 0.95)),
                        url('&track=ais_hybrid&quer''') center/cover no-repeat;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: clamp(20px, 5vh, 40px) clamp(16px, 4vw, 24px);
            z-index: 10;
            transition: transform 0.5s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.5s ease;
        }

        .landing-screen.hidden {
            transform: translateY(-100%);
            opacity: 0;
            pointer-events: none;
        }

        .landing-top {
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .brand-badge {
            display: flex;
            align-items: center;
            gap: 8px;
            background: rgba(255, 255, 255, 0.12);
            backdrop-filter: blur(10px);
            padding: 6px 16px;
            border-radius: 30px;
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .brand-badge i { color: var(--pink-accent); }
        .brand-badge span { font-size: 0.85rem; font-weight: 700; }

        .landing-center {
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .center-logo-bounce {
            width: clamp(65px, 15vw, 85px);
            height: clamp(65px, 15vw, 85px);
            background: var(--purple-gradient);
            border-radius: 24px;
            display: flex;
            justify-content: center;
            align-items: center;
            box-shadow: 0 12px 30px rgba(155, 81, 224, 0.6);
            margin-bottom: 20px;
            animation: softPulse 2s infinite ease-in-out;
        }

        .center-logo-bounce i { font-size: clamp(1.8rem, 5vw, 2.5rem); color: #fff; }

        @keyframes softPulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.06); }
        }

        .slogan-title {
            font-size: clamp(1.3rem, 4vw, 1.65rem);
            font-weight: 800;
            line-height: 1.35;
            margin-bottom: 8px;
            text-shadow: 0 2px 10px rgba(0,0,0,0.7);
        }

        .slogan-sub {
            font-size: clamp(0.8rem, 2.5vw, 0.92rem);
            color: var(--text-muted);
            max-width: 320px;
        }

        .landing-actions {
            display: flex;
            flex-direction: column;
            gap: 12px;
            width: 100%;
        }

        .btn-gmail, .btn-register {
            width: 100%;
            padding: clamp(12px, 2.5vh, 16px);
            border-radius: var(--radius-md);
            font-size: clamp(0.88rem, 2.5vw, 1rem);
            font-weight: 700;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            transition: var(--transition);
            border: none;
        }

        .btn-gmail {
            background: rgba(255, 255, 255, 0.95);
            color: #111;
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
        }

        .btn-register {
            background: var(--purple-gradient);
            color: #fff;
            box-shadow: 0 10px 25px rgba(155, 81, 224, 0.5);
        }

        /* ==================== 3. ONBOARDING SLIDER ==================== */
        .onboarding-screen {
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
            position: absolute;
            inset: 0;
            z-index: 5;
            transition: opacity 0.4s ease, visibility 0.4s ease;
        }

        .onboarding-screen.hidden {
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
        }

        .header-bar {
            padding: clamp(12px, 2vh, 20px) 20px 8px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            z-index: 20;
        }

        .back-btn {
            background: rgba(255, 255, 255, 0.1);
            border: none;
            color: var(--text-main);
            width: 38px;
            height: 38px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: var(--transition);
        }

        .progress-track {
            flex: 1;
            height: 6px;
            background: rgba(255, 255, 255, 0.12);
            border-radius: 3px;
            margin: 0 14px;
            overflow: hidden;
        }

        .progress-fill {
            height: 100%;
            width: 8%;
            background: var(--purple-gradient);
            border-radius: 3px;
            transition: var(--transition);
        }

        .slider-wrapper {
            flex: 1;
            display: flex;
            width: 100%;
            height: 100%;
            transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1);
        }

        .question-page {
            min-width: 100%;
            height: 100%;
            padding: 10px clamp(16px, 4vw, 24px) clamp(16px, 3vh, 30px) clamp(16px, 4vw, 24px);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            overflow-y: auto;
        }

        .q-title {
            font-size: clamp(1.25rem, 3.5vw, 1.55rem);
            font-weight: 800;
            line-height: 1.3;
            margin-bottom: 6px;
            background: linear-gradient(to right, #ffffff, #e2d2f7);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .q-subtitle {
            font-size: clamp(0.78rem, 2vw, 0.88rem);
            color: var(--text-muted);
            margin-bottom: 16px;
        }

        .options-list { display: flex; flex-direction: column; gap: 8px; }

        .option-card {
            background: var(--option-bg);
            border: 1.5px solid var(--option-border);
            padding: clamp(10px, 1.8vh, 14px) 16px;
            border-radius: var(--radius-md);
            display: flex;
            align-items: center;
            justify-content: space-between;
            cursor: pointer;
            transition: var(--transition);
            font-weight: 600;
            font-size: clamp(0.85rem, 2.2vw, 0.95rem);
        }

        .option-card.selected {
            background: rgba(155, 81, 224, 0.28);
            border-color: var(--purple-main);
            box-shadow: 0 6px 20px rgba(155, 81, 224, 0.35);
        }

        .silhouette-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
        .silhouette-card {
            background: var(--option-bg);
            border: 1.5px solid var(--option-border);
            border-radius: var(--radius-md);
            padding: 6px;
            text-align: center;
            cursor: pointer;
            transition: var(--transition);
        }

        .silhouette-card img {
            width: 100%;
            height: clamp(110px, 18vh, 155px);
            object-fit: cover;
            border-radius: 10px;
            margin-bottom: 6px;
        }

        .silhouette-card.selected {
            background: rgba(155, 81, 224, 0.3);
            border-color: var(--purple-main);
        }

        .silhouette-card span { font-size: clamp(0.7rem, 2vw, 0.82rem); font-weight: 700; }

        .passions-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 8px;
            max-height: 52vh;
            overflow-y: auto;
        }

        .passion-item {
            background: var(--option-bg);
            border: 1.5px solid var(--option-border);
            padding: 6px 8px;
            border-radius: var(--radius-md);
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            font-size: clamp(0.75rem, 2vw, 0.85rem);
            font-weight: 700;
        }

        .passion-item img { width: 38px; height: 38px; border-radius: 8px; object-fit: cover; }
        .passion-item.selected { background: rgba(155, 81, 224, 0.35); border-color: var(--purple-main); }

        .photo-upload-grid { 
            display: grid; 
            grid-template-columns: repeat(3, 1fr); 
            gap: 8px; 
        }
        .photo-box {
            height: clamp(100px, 16vh, 130px);
            border: 2px dashed var(--option-border);
            border-radius: var(--radius-md);
            background: rgba(255, 255, 255, 0.04);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow: hidden;
            text-align: center;
            padding: 4px;
        }

        .photo-box.main-photo-box {
            border-color: var(--purple-main);
            background: rgba(155, 81, 224, 0.1);
        }

        .photo-box input[type="file"] { position: absolute; inset: 0; opacity: 0; cursor: pointer; z-index: 2; }
        .photo-preview { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: none; z-index: 1; }

        .input-field {
            width: 100%;
            padding: clamp(12px, 2vh, 16px) 18px;
            background: rgba(255, 255, 255, 0.06);
            border: 1.5px solid var(--option-border);
            border-radius: var(--radius-md);
            color: var(--text-main);
            font-size: 0.95rem;
            outline: none;
            transition: var(--transition);
        }

        .error-msg {
            color: #ff4d4d;
            font-size: 0.8rem;
            font-weight: 700;
            margin-top: 10px;
            display: none;
            align-items: center;
            gap: 6px;
            animation: fadeInError 0.3s ease;
        }

        @keyframes fadeInError {
            from { opacity: 0; transform: translateY(-4px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .input-field.input-error {
            border-color: #ff4d4d !important;
        }

        .btn-continue {
            width: 100%;
            padding: clamp(12px, 2vh, 16px);
            background: var(--purple-gradient);
            border: none;
            border-radius: var(--radius-md);
            color: #fff;
            font-size: clamp(0.9rem, 2.5vw, 1rem);
            font-weight: 700;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin-top: 10px;
        }

        .rules-list {
            display: flex;
            flex-direction: column;
            gap: 8px;
            max-height: 48vh;
            overflow-y: auto;
        }

        .rule-item {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--option-border);
            border-radius: var(--radius-md);
            padding: 10px 12px;
            display: flex;
            gap: 10px;
            align-items: flex-start;
        }

        .rule-item i { font-size: 1.1rem; color: var(--pink-accent); margin-top: 2px; }
        .rule-item p { font-size: 0.8rem; line-height: 1.35; color: var(--text-muted); }
        .rule-item p strong { color: #fff; display: block; margin-bottom: 2px; font-size: 0.88rem; }

        /* ==================== 4. MAIN APPLICATION SCREEN ==================== */
        .main-app-screen {
            position: absolute;
            inset: 0;
            background: #ffffff;
            color: #111;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            z-index: 1;
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.5s ease;
        }

        .main-app-screen.active {
            opacity: 1;
            visibility: visible;
            z-index: 20;
        }

        /* Top Bar */
        .app-header {
            padding: clamp(10px, 1.8vh, 16px) clamp(14px, 4vw, 20px) 8px clamp(14px, 4vw, 20px);
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: #ffffff;
        }

        .app-brand-name {
            font-size: clamp(1.15rem, 3.5vw, 1.35rem);
            font-weight: 800;
            color: #4a154b;
        }

        .header-actions { display: flex; align-items: center; gap: 8px; }

        .coins-badge {
            background: #f7f3fb;
            border: 1px solid #e2d2f7;
            padding: 4px 10px;
            border-radius: 20px;
            display: flex;
            align-items: center;
            gap: 5px;
            font-size: 0.8rem;
            font-weight: 800;
            color: #333;
            cursor: pointer;
        }

        .header-icon-btn {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            border: none;
            background: transparent;
            color: #666;
            font-size: 1rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* Container de Contenu Onglets */
        .tab-content-container {
            flex: 1;
            display: flex;
            flex-direction: column;
            position: relative;
            overflow: hidden;
        }

        .tab-view {
            position: absolute;
            inset: 0;
            display: none;
            flex-direction: column;
            overflow-y: auto;
        }

        .tab-view.active {
            display: flex;
        }

        /* Onglet Rencontres (Galerie 6 photos) */
        .card-container {
            flex: 1;
            padding: 4px clamp(10px, 3vw, 16px) 10px clamp(10px, 3vw, 16px);
            display: flex;
            flex-direction: column;
            align-items: center;
            position: relative;
            min-height: 0;
            user-select: none;
        }

        .profile-card {
            width: 100%;
            height: 100%;
            border-radius: clamp(20px, 5vw, 28px);
            overflow: hidden;
            position: relative;
            box-shadow: 0 12px 30px rgba(0,0,0,0.15);
            background: #222;
            touch-action: pan-y;
            will-change: transform;
        }

        .profile-card img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            pointer-events: none;
        }

        /* TAPs de navigation entre les 6 photos */
        .photo-nav-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 70%;
            display: flex;
            z-index: 4;
        }

        .photo-nav-left, .photo-nav-right {
            flex: 1;
            height: 100%;
        }

        /* Indicateurs de photos (Barres) */
        .photo-indicators {
            position: absolute;
            top: 12px;
            left: 12px;
            right: 12px;
            display: flex;
            gap: 4px;
            z-index: 5;
        }

        .photo-indicator-bar {
            flex: 1;
            height: 3px;
            background: rgba(255, 255, 255, 0.4);
            border-radius: 2px;
            transition: background 0.3s ease;
        }

        .photo-indicator-bar.active {
            background: #ffffff;
            box-shadow: 0 0 4px rgba(0, 0, 0, 0.5);
        }

        .profile-card-overlay {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            padding: 40px clamp(14px, 4vw, 20px) clamp(80px, 11vh, 90px) clamp(14px, 4vw, 20px);
            background: linear-gradient(to top, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.4) 60%, transparent 100%);
            color: #fff;
            pointer-events: none;
            z-index: 3;
        }

        .profile-name-age {
            font-size: clamp(1.25rem, 4vw, 1.45rem);
            font-weight: 800;
            line-height: 1.2;
            text-shadow: 0 2px 8px rgba(0,0,0,0.5);
        }

        .profile-location {
            font-size: clamp(0.75rem, 2vw, 0.82rem);
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            margin-top: 3px;
            opacity: 0.9;
        }

        /* Actions Flottantes Sur Carte */
        .action-buttons-bar {
            position: absolute;
            bottom: clamp(16px, 3vh, 24px);
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            align-items: center;
            gap: clamp(12px, 3.5vw, 18px);
            z-index: 10;
            pointer-events: auto;
        }

        .action-btn {
            border: none;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
            transition: transform 0.2s ease;
        }

        .action-btn:active { transform: scale(0.9); }

        .btn-dislike {
            width: clamp(48px, 12vw, 56px);
            height: clamp(48px, 12vw, 56px);
            background: #ffffff;
            color: #ff4d4d;
            font-size: clamp(1.2rem, 3.5vw, 1.5rem);
        }

        .btn-message {
            width: clamp(52px, 13vw, 60px);
            height: clamp(52px, 13vw, 60px);
            background: #4a154b;
            color: #ffffff;
            font-size: clamp(1.2rem, 3.5vw, 1.5rem);
            position: relative;
        }

        .btn-message .msg-badge {
            position: absolute;
            top: -2px;
            right: -2px;
            background: #0084ff;
            color: #fff;
            font-size: 0.68rem;
            font-weight: 800;
            width: 18px;
            height: 18px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid #ffffff;
        }

        .btn-like {
            width: clamp(56px, 14vw, 64px);
            height: clamp(56px, 14vw, 64px);
            background: linear-gradient(135deg, #e91e63, #9b51e0);
            color: #ffffff;
            font-size: clamp(1.3rem, 4vw, 1.7rem);
        }

        /* ==================== STYLES SECTION DISCUSSIONS & ARCHIVES ==================== */
        .discussions-container {
            display: flex;
            flex-direction: column;
            height: 100%;
            background: linear-gradient(180deg, #9b51e0 0%, #b832e9 35%, #ffffff 75%);
            color: #222;
            position: relative;
        }

        .discussions-header {
            padding: 16px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            color: #ffffff;
        }

