        /* ==================== 2. CARROUSEL FLUIDE DES RENCONTRES (6 PHOTOS) ==================== */
        function renderProfileCard() {
            const currentProfile = sampleProfiles[currentProfileIndex];
            const cardImg = document.getElementById('card-image');
            const cardNameAge = document.getElementById('card-name-age');
            const cardLocation = document.getElementById('card-location');
            const photoIndicatorsContainer = document.getElementById('photo-indicators');

            cardImg.src = currentProfile.photos[currentPhotoIndex];
            cardNameAge.innerText = currentProfile.name;
            cardLocation.innerText = currentProfile.location;

            photoIndicatorsContainer.innerHTML = '';
            currentProfile.photos.forEach((_, idx) => {
                const bar = document.createElement('div');
                bar.className = `photo-indicator-bar ${idx === currentPhotoIndex ? 'active' : ''}`;
                photoIndicatorsContainer.appendChild(bar);
            });
        }

        function nextCardPhoto(e) {
            if(e) e.stopPropagation();
            const currentProfile = sampleProfiles[currentProfileIndex];
            if (currentPhotoIndex < currentProfile.photos.length - 1) {
                currentPhotoIndex++;
                renderProfileCard();
            }
        }

        function prevCardPhoto(e) {
            if(e) e.stopPropagation();
            if (currentPhotoIndex > 0) {
                currentPhotoIndex--;
                renderProfileCard();
            }
        }

        function swipeCard(action) {
            const card = document.getElementById('profile-card');
            card.style.transition = 'transform 0.4s ease, opacity 0.4s ease';

            if (action === 'like') {
                card.style.transform = 'translateX(120%) rotate(20deg)';
                matchesCount++;
                document.getElementById('matches-count-badge').innerText = matchesCount;
                document.getElementById('matches-status-text').innerText = `Tu as ${matchesCount} nouveau(x) match(s) !`;
            } else if (action === 'dislike') {
                card.style.transform = 'translateX(-120%) rotate(-20deg)';
            }

            card.style.opacity = '0';

            setTimeout(() => {
                currentProfileIndex = (currentProfileIndex + 1) % sampleProfiles.length;
                currentPhotoIndex = 0;
                card.style.transition = 'none';
                card.style.transform = 'none';
                card.style.opacity = '1';
                renderProfileCard();
            }, 400);
        }

        function initCardSwipe() {
            const card = document.getElementById('profile-card');
            let startX = 0;
            let currentX = 0;
            let isDragging = false;

            card.addEventListener('touchstart', (e) => {
                startX = e.touches[0].clientX;
                isDragging = true;
                card.style.transition = 'none';
            }, { passive: true });

            card.addEventListener('touchmove', (e) => {
                if (!isDragging) return;
                currentX = e.touches[0].clientX - startX;
                const rotate = currentX * 0.08;
                card.style.transform = `translateX(${currentX}px) rotate(${rotate}deg)`;
            }, { passive: true });

            card.addEventListener('touchend', () => {
                if (!isDragging) return;
                isDragging = false;
                if (currentX > 100) {
                    swipeCard('like');
                } else if (currentX < -100) {
                    swipeCard('dislike');
                } else {
                    card.style.transition = 'transform 0.3s ease';
                    card.style.transform = 'none';
                }
                currentX = 0;
            });
        }

