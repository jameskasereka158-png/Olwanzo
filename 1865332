        /* ==================== 6. PROFIL NAVIGATION & ÉDITION ==================== */
        let navigationHistory = ['view-profile'];
        let titleHistory = ['Profil'];

        function navigateTo(viewId, title) {
            document.querySelectorAll('.profile-subview').forEach(el => el.classList.remove('active'));
            document.getElementById(viewId).classList.add('active');
            
            navigationHistory.push(viewId);
            titleHistory.push(title);
            
            document.getElementById('headerTitle').textContent = title;
            document.getElementById('backBtn').style.display = 'block';

            if(viewId === 'view-simple') {
                document.getElementById('simpleViewContent').textContent = title;
            }
        }

        function navigateBack() {
            if (navigationHistory.length > 1) {
                navigationHistory.pop();
                titleHistory.pop();
                
                const previousView = navigationHistory[navigationHistory.length - 1];
                const previousTitle = titleHistory[titleHistory.length - 1];
                
                document.querySelectorAll('.profile-subview').forEach(el => el.classList.remove('active'));
                document.getElementById(previousView).classList.add('active');
                document.getElementById('headerTitle').textContent = previousTitle;
                
                if (navigationHistory.length === 1) {
                    document.getElementById('backBtn').style.display = 'none';
                }
            }
        }

        function updateProfileAvatar(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    userProfileData.photos[0] = e.target.result;
                    updateAvatarDisplay(e.target.result);
                    const mainEditPrev = document.getElementById('edit-prev-1');
                    mainEditPrev.src = e.target.result;
                    mainEditPrev.style.display = 'block';
