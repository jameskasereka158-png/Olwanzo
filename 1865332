        let currentProfileIndex = 0;
        let currentPhotoIndex = 0;
        let matchesCount = 0;

        /* Profil Utilisateur dynamique & connecté */
        let userProfileData = {
            name: "Utilisateur OLWANZO",
            age: 24,
            province: "Nord-Kivu",
            city: "Goma",
            croyance: "Chrétien(ne)",
            enfants: "Non",
            cigarette: "Non",
            photos: []
        };

        window.addEventListener('load', () => {
            setTimeout(() => {
                const splash = document.getElementById('splash-screen');
                splash.style.opacity = '0';
                splash.style.visibility = 'hidden';
            }, 2000);

            initCardSwipe();
            renderProfileCard();
            syncProfileToUI();
        });

        function startRegistration() {
            document.getElementById('landing-screen').classList.add('hidden');
            currentPageIndex = 0;
            updateSlider();
        }

        function loginWithGmail() {
            goToMainApp();
        }

        function updateSlider() {
            const wrapper = document.getElementById('slider-wrapper');
            wrapper.style.transform = `translateX(-${currentPageIndex * 100}%)`;

            const progress = ((currentPageIndex + 1) / totalPages) * 100;
            document.getElementById('progress-fill').style.width = `${progress}%`;
            document.getElementById('page-counter').innerText = `${currentPageIndex + 1}/${totalPages}`;
        }

        function showError(message) {
            let parent = document.getElementById(`page-${currentPageIndex}`);
            let existingError = parent.querySelector('.error-msg');
            
            if (!existingError) {
                existingError = document.createElement('div');
                existingError.className = 'error-msg';
                existingError.innerHTML = `<i class="fa-solid fa-circle-exclamation"></i> <span>${message}</span>`;
                parent.querySelector('div').appendChild(existingError);
            } else {
                existingError.querySelector('span').innerText = message;
            }
            
            existingError.style.display = 'flex';
        }

        function clearError() {
            let parent = document.getElementById(`page-${currentPageIndex}`);
            let existingError = parent.querySelector('.error-msg');
            if (existingError) {
                existingError.style.display = 'none';
            }
            let input = parent.querySelector('.input-field');
            if (input) {
                input.classList.remove('input-error');
            }
        }

        function validateCurrentPage() {
            clearError();
            const currentPage = document.getElementById(`page-${currentPageIndex}`);
            
            if (currentPageIndex === 0) {
                const input = document.getElementById('input-name');
                if (!input.value.trim()) {
                    input.classList.add('input-error');
                    showError("Veuillez entrer votre prénom pour continuer.");
                    return false;
                }
                userProfileData.name = input.value.trim();
            }
            else if (currentPageIndex === 1) {
                const input = document.getElementById('input-age');
                const age = parseInt(input.value);
                if (!age || age < 18) {
                    input.classList.add('input-error');
                    showError("Veuillez entrer un âge valide (18 ans minimum).");
                    return false;
                }
                userProfileData.age = age;
            }
            else if (currentPageIndex === 2) {
                const selected = currentPage.querySelector('.option-card.selected');
                if (!selected) {
                    showError("Veuillez faire un choix pour continuer.");
                    return false;
                }
                userProfileData.province = selected.innerText.replace(/[^a-zA-Z-\s]/g, '').trim();
            }
            else if (currentPageIndex === 3) {
                const selected = currentPage.querySelector('.option-card.selected');
                if (!selected) {
                    showError("Veuillez faire un choix pour continuer.");
                    return false;
                }
                userProfileData.city = selected.innerText.replace(/[^a-zA-Z-\s]/g, '').trim();
            }
            else if (currentPageIndex === 4) {
                const selected = currentPage.querySelector('.option-card.selected');
                if (!selected) {
                    showError("Veuillez faire un choix pour continuer.");
                    return false;
                }
                userProfileData.croyance = selected.innerText.replace(/[^a-zA-Z-\s()]/g, '').trim();
            }
            else if (currentPageIndex === 5) {
                const selected = currentPage.querySelector('.option-card.selected');
                if (!selected) {
                    showError("Veuillez faire un choix pour continuer.");
                    return false;
                }
                userProfileData.enfants = selected.innerText.includes("Oui") ? "Oui" : "Non";
            }
            else if (currentPageIndex === 6) {
                const selected = currentPage.querySelector('.option-card.selected');
                if (!selected) {
                    showError("Veuillez faire un choix pour continuer.");
                    return false;
                }
                userProfileData.cigarette = selected.innerText.includes("Oui") ? "Oui" : "Non";
            }
            else if (currentPageIndex === 7) {
                const selected = currentPage.querySelector('.silhouette-card.selected');
                if (!selected) {
                    showError("Veuillez choisir une silhouette pour continuer.");
                    return false;
                }
            }
            else if (currentPageIndex === 8) {
                const selected = currentPage.querySelectorAll('.passion-item.selected');
                if (selected.length === 0) {
                    showError("Veuillez sélectionner au moins une passion.");
                    return false;
                }
            }
            else if (currentPageIndex === 9) {
                const photo1 = document.getElementById('photo-input-1').files[0];
                if (!photo1 && userProfileData.photos.length === 0) {
                    showError("Veuillez ajouter au moins la photo principale.");
                    return false;
                }
            }

            syncProfileToUI();
            return true;
        }

